{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "licenkit-server",
  "main": "./apps/server/src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "licenkit-db",
      "database_id": "licenkit-d1-placeholder",
      "migrations_dir": "./apps/server/drizzle"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_VERSION": "1.0.0",
    "TURNSTILE_SITE_KEY": "replace-with-turnstile-site-key",
    "CUSTOMER_MAGIC_LINK_COOLDOWN_SECONDS": "60"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
