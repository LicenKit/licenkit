{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "licenkit-server",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "licenkit-db",
      "database_id": "licenkit-d1-placeholder",
      "migrations_dir": "./drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KEYS_KV",
      "id": "licenkit-kv-placeholder"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENT_QUEUE",
        "queue": "licenkit-event-queue"
      }
    ],
    "consumers": [
      {
        "queue": "licenkit-event-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_VERSION": "1.0.0"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
